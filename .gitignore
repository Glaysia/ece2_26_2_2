# Obsidian community plugin bundles can be large and are reproducible.
.obsidian/plugins/*/main.js

reference/*

# Lecture PNG captures are local build assets; published PDFs are versioned.
weekly-slides/weekly-slides/**/assets/**/*.png
weekly-slides/weekly-slides/**/assets/**/*.jpg
weekly-slides/weekly-slides/**/assets/**/*.jpeg

# Delivery copies; canonical lecture PDFs and ZIPs live beside the TeX sources.
/output/pdf/

# XeLaTeX/Beamer build products
weekly-slides/build/
weekly-slides/*.aux
weekly-slides/*.log
weekly-slides/*.nav
weekly-slides/*.out
weekly-slides/*.pdf
weekly-slides/*.snm
weekly-slides/*.synctex.*
weekly-slides/*.toc
weekly-slides/*.xdv

tmp/*

# Local HDL/PDF verification products
/build/
weekly-slides/weekly-slides/**/build*.txt
weekly-slides/weekly-slides/**/*-rebuild-*.txt
**/__pycache__/

**/*.log
**/*.jou
