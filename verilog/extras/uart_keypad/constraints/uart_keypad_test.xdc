# Manufacturer USB232 example + Combo II-DLD manual button pin table. MAIN CLOCK F=50 MHz.
set_property PACKAGE_PIN B6 [get_ports {clk}]
set_property IOSTANDARD LVCMOS33 [get_ports {clk}]
set_property PACKAGE_PIN C6 [get_ports {uart_rxd}]
set_property IOSTANDARD LVCMOS33 [get_ports {uart_rxd}]
set_property PACKAGE_PIN F6 [get_ports {uart_txd}]
set_property IOSTANDARD LVCMOS33 [get_ports {uart_txd}]
set_property PACKAGE_PIN K4 [get_ports {keys[0]}]
set_property IOSTANDARD LVCMOS33 [get_ports {keys[0]}]
set_property PACKAGE_PIN N8 [get_ports {keys[1]}]
set_property IOSTANDARD LVCMOS33 [get_ports {keys[1]}]
set_property PACKAGE_PIN N4 [get_ports {keys[2]}]
set_property IOSTANDARD LVCMOS33 [get_ports {keys[2]}]
set_property PACKAGE_PIN N1 [get_ports {keys[3]}]
set_property IOSTANDARD LVCMOS33 [get_ports {keys[3]}]
set_property PACKAGE_PIN P6 [get_ports {keys[4]}]
set_property IOSTANDARD LVCMOS33 [get_ports {keys[4]}]
set_property PACKAGE_PIN N6 [get_ports {keys[5]}]
set_property IOSTANDARD LVCMOS33 [get_ports {keys[5]}]
set_property PACKAGE_PIN L5 [get_ports {keys[6]}]
set_property IOSTANDARD LVCMOS33 [get_ports {keys[6]}]
set_property PACKAGE_PIN J2 [get_ports {keys[7]}]
set_property IOSTANDARD LVCMOS33 [get_ports {keys[7]}]
set_property PACKAGE_PIN K2 [get_ports {keys[8]}]
set_property IOSTANDARD LVCMOS33 [get_ports {keys[8]}]
set_property PACKAGE_PIN L7 [get_ports {keys[9]}]
set_property IOSTANDARD LVCMOS33 [get_ports {keys[9]}]
set_property PACKAGE_PIN L1 [get_ports {keys[10]}]
set_property IOSTANDARD LVCMOS33 [get_ports {keys[10]}]
set_property PACKAGE_PIN K6 [get_ports {keys[11]}]
set_property IOSTANDARD LVCMOS33 [get_ports {keys[11]}]
set_property PACKAGE_PIN N5 [get_ports {led[0]}]
set_property IOSTANDARD LVCMOS33 [get_ports {led[0]}]
set_property PACKAGE_PIN M1 [get_ports {led[1]}]
set_property IOSTANDARD LVCMOS33 [get_ports {led[1]}]
set_property PACKAGE_PIN M3 [get_ports {led[2]}]
set_property IOSTANDARD LVCMOS33 [get_ports {led[2]}]
set_property PACKAGE_PIN M7 [get_ports {led[3]}]
set_property IOSTANDARD LVCMOS33 [get_ports {led[3]}]
set_property PACKAGE_PIN N7 [get_ports {led[4]}]
set_property IOSTANDARD LVCMOS33 [get_ports {led[4]}]
set_property PACKAGE_PIN M2 [get_ports {led[5]}]
set_property IOSTANDARD LVCMOS33 [get_ports {led[5]}]
set_property PACKAGE_PIN M4 [get_ports {led[6]}]
set_property IOSTANDARD LVCMOS33 [get_ports {led[6]}]
set_property PACKAGE_PIN L4 [get_ports {led[7]}]
set_property IOSTANDARD LVCMOS33 [get_ports {led[7]}]
create_clock -name main_clk -period 20.000 [get_ports clk]
# Manufacturer Xilinx S7 Pin Map: BDIO00 through BDIO15, in order.
set_property PACKAGE_PIN F8 [get_ports {gpio_monitor[0]}]
set_property PACKAGE_PIN E8 [get_ports {gpio_monitor[1]}]
set_property PACKAGE_PIN A7 [get_ports {gpio_monitor[2]}]
set_property PACKAGE_PIN G8 [get_ports {gpio_monitor[3]}]
set_property PACKAGE_PIN D7 [get_ports {gpio_monitor[4]}]
set_property PACKAGE_PIN B7 [get_ports {gpio_monitor[5]}]
set_property PACKAGE_PIN G7 [get_ports {gpio_monitor[6]}]
set_property PACKAGE_PIN F7 [get_ports {gpio_monitor[7]}]
set_property PACKAGE_PIN C8 [get_ports {gpio_monitor[8]}]
set_property PACKAGE_PIN D8 [get_ports {gpio_monitor[9]}]
set_property PACKAGE_PIN C9 [get_ports {gpio_monitor[10]}]
set_property PACKAGE_PIN B8 [get_ports {gpio_monitor[11]}]
set_property PACKAGE_PIN A9 [get_ports {gpio_monitor[12]}]
set_property PACKAGE_PIN B9 [get_ports {gpio_monitor[13]}]
set_property PACKAGE_PIN A10 [get_ports {gpio_monitor[14]}]
set_property PACKAGE_PIN B10 [get_ports {gpio_monitor[15]}]
set_property IOSTANDARD LVCMOS33 [get_ports {gpio_monitor[*]}]
set_property DRIVE 8 [get_ports {gpio_monitor[*]}]
set_property SLEW SLOW [get_ports {gpio_monitor[*]}]
set_false_path -from [get_ports {uart_rxd keys[*]}]
